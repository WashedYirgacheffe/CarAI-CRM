// 车车外贸 CRM — 数据模型
// 约定：所有业务表都带 tenantId，通过 src/server/db.ts 的 tenantDb() 自动隔离。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 企业（租户）。注册时创建，一个企业对应一个主账号。
model Tenant {
  id                    String   @id @default(cuid())
  name                  String
  defaultCurrency       String   @default("USD")
  timezone              String   @default("Asia/Shanghai")
  /// 公海规则：负责人超过 N 天未跟进，客户自动回到公海（0 = 不自动回收）
  poolRecycleDays       Int      @default(30)
  /// 每人每天最多从公海领取的客户数（0 = 不限）
  poolDailyClaimLimit   Int      @default(20)
  /// 每人最多持有的私海客户数（0 = 不限）
  privateCustomerLimit  Int      @default(0)
  /// 公海回收依据：contact = 最近联系（收发邮件、WhatsApp、跟进都算）；follow = 最近跟进（销售手写的跟进）
  poolBasis             String   @default("contact")
  /// 进公海前 N 天给负责人建提醒任务（0 = 不提醒）
  poolWarnDays          Int      @default(7)
  // ── 单据抬头（报价单 / PI 上显示，英文） ──
  docCompanyName        String?
  docAddress            String?
  docPhone              String?
  docEmail              String?
  docWebsite            String?
  /// 收款银行信息，原样打印在 PI 上
  docBankInfo           String?
  /// 报价单默认条款
  docQuotationTerms     String?
  /// 报价单默认有效期（天）
  quotationValidDays    Int      @default(30)
  /// 社媒跟踪：客户星级达到几星才自动跟踪它的社媒更新（0 = 不跟踪）
  socialWatchStar       Int      @default(3)
  /// 社媒矩阵运行器令牌（sha256，明文只在生成时显示一次）
  matrixRunnerTokenHash String?
  /// 云端运行器（Vercel Sandbox）：默认关，账号都在负责人的桌面软件里跑；打开后没有归属设备的账号交给云端
  matrixCloudEnabled    Boolean  @default(false)
  // ── 审批规则（0 / false = 不需要审批；有「审批」权限的人自己操作不用审批） ──
  /// 报价单、订单的折扣超过合计的 N% 要审批
  approvalDiscountPct   Int      @default(0)
  /// 业务员把客户退回公海要审批
  approvalRelease       Boolean  @default(false)
  /// 删除客户要审批
  approvalDelete        Boolean  @default(false)
  /// 转移客户给别人要审批
  approvalTransfer      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users             User[]
  departments       Department[]
  roles             Role[]
  customers         Customer[]
  statuses          CustomerStatus[]
  groups            CustomerGroup[]
  contacts          Contact[]
  leads             Lead[]
  stages            Stage[]
  opportunities     Opportunity[]
  activities        Activity[]
  tasks             Task[]
  productCategories ProductCategory[]
  products          Product[]
  exchangeRates     ExchangeRate[]
  quotations        Quotation[]
  orders            Order[]
  orderPayments     OrderPayment[]
  mailAccounts      MailAccount[]
  mailMessages      MailMessage[]
  waAccounts        WaAccount[]
  waChats           WaChat[]
  waMessages        WaMessage[]
  aiInsights        AiInsight[]
  segments          CustomerSegment[]
  suggestionIgnores SuggestionIgnore[]
  mailSequences     MailSequence[]
  mailEnrollments   MailEnrollment[]
  mailEvents        MailEvent[]
  mailSuppressions  MailSuppression[]
  workspaces        Workspace[]
  aiThreads         AiThread[]
  aiMemories        AiMemory[]
  aiResearches      AiResearch[]
  shareVisits       ShareVisit[]
  customerSocials   CustomerSocial[]
  socialPosts       SocialPost[]
  bioPages          BioPage[]
  matrixProxies     MatrixProxy[]
  matrixAccounts    MatrixAccount[]
  matrixDevices     MatrixDevice[]
  matrixJobs        MatrixJob[]
  matrixUsage       MatrixUsage[]
  matrixEvents      MatrixEvent[]
  socialThreads     SocialThread[]
  socialMessages    SocialMessage[]
  quickReplies      QuickReply[]
  files             CrmFile[]
  shipments         Shipment[]
  paymentPlans      PaymentPlan[]
  auditLogs         AuditLog[]
  approvals         ApprovalRequest[]
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// 账号。isOwner = 主账号（企业创建者，不可被禁用/删除）。
model User {
  id                 String     @id @default(cuid())
  tenantId           String
  email              String     @unique
  name               String
  phone              String?
  passwordHash       String
  isOwner            Boolean    @default(false)
  status             UserStatus @default(ACTIVE)
  departmentId       String?
  roleId             String
  lastLoginAt        DateTime?
  /// 工作台卡片（顺序即显示顺序）；空数组表示用默认布局
  dashboardCards     String[]   @default([])
  /// 工作台默认情景：null = 还没选过（离开时会提示保存）；"overview" = 系统概览；否则是 Workspace.id
  dashboardHome      String?
  /// 不再提示「保存为默认情景」
  dashboardPromptOff Boolean    @default(false)
  /// 收起了「上手清单」
  onboardingOff      Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions   Session[]

  ownedCustomers     Customer[]      @relation("CustomerOwner")
  prevCustomers      Customer[]      @relation("CustomerPrevOwner")
  ownedLeads         Lead[]          @relation("LeadOwner")
  ownedOpportunities Opportunity[]   @relation("OpportunityOwner")
  activities         Activity[]
  tasks              Task[]          @relation("TaskOwner")
  ownedQuotations    Quotation[]     @relation("QuotationOwner")
  ownedOrders        Order[]         @relation("OrderOwner")
  mailAccounts       MailAccount[]
  waAccounts         WaAccount[]
  workspaces         Workspace[]
  aiThreads          AiThread[]
  aiMemories         AiMemory[]
  bioPage            BioPage?
  matrixAccounts     MatrixAccount[] @relation("MatrixAccountOwner")
  matrixDevices      MatrixDevice[]
  socialThreads      SocialThread[]  @relation("SocialThreadAssignee")
  files              CrmFile[]

  @@index([tenantId])
}

/// 登录会话。id 是 token 的 SHA-256，数据库里不存明文 token。
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 部门，树形结构。根部门在注册时以企业名创建。
model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentTree")
  users    User[]
  bioPages BioPage[]

  @@index([tenantId])
}

/// 数据范围：决定一个角色能看到哪些客户/商机等业务数据。
enum DataScope {
  SELF // 仅本人
  DEPARTMENT // 本部门（含下级部门）
  ALL // 全公司
}

/// 角色。permissions 是权限点 key 列表，定义见 src/lib/permissions.ts。
model Role {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  /// 系统内置角色的标识（admin / manager / sales），自定义角色为空
  systemKey   String?
  permissions String[]
  dataScope   DataScope @default(SELF)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ================= P1：客户与销售 =================

/// 客户状态（企业自定义，如：询盘客户、样品客户、成交客户）
model CustomerStatus {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String @default("slate")
  sort     Int    @default(0)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([tenantId, name])
}

/// 客户分组，最多 3 级
model CustomerGroup {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  parentId String?
  sort     Int     @default(0)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    CustomerGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  CustomerGroup[] @relation("GroupTree")
  customers Customer[]

  @@index([tenantId])
}

/// 客户（公司）。ownerId 为空 = 在公海。
model Customer {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  /// 规范化名称（小写、去空格和标点、去公司后缀），企业内唯一，用于防撞单
  nameKey         String
  country         String?
  website         String?
  /// 官网或邮箱域名，用于查重和邮件自动匹配
  domain          String?
  address         String?
  source          String?
  customerType    String?
  mainProducts    String?
  annualVolume    String?
  star            Int       @default(0)
  statusId        String?
  groupId         String?
  tags            String[]
  remark          String?
  ownerId         String?
  assignedAt      DateTime?
  /// 最近联系：任何往来（收发邮件、WhatsApp、跟进）
  lastContactAt   DateTime?
  /// 最近跟进：销售手写的跟进记录
  lastFollowAt    DateTime?
  lastMailRecvAt  DateTime?
  lastMailSentAt  DateTime?
  lastWaAt        DateTime?
  nextFollowAt    DateTime?
  poolEnteredAt   DateTime?
  poolReason      String?
  /// 累计进入公海次数
  poolCount       Int       @default(0)
  /// 上一任负责人（进公海或转移前）
  prevOwnerId     String?
  /// 按公海规则算出的下次自动进公海时间（worker 每小时刷新）
  poolDueAt       DateTime?
  /// 已发过进公海提醒的时间；下次进公海时间推后会清空
  poolWarnedAt    DateTime?
  /// AI 上次从邮件 / WhatsApp 里提炼客户记忆的时间
  memoryScannedAt DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?            @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  prevOwner     User?            @relation("CustomerPrevOwner", fields: [prevOwnerId], references: [id], onDelete: SetNull)
  status        CustomerStatus?  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  group         CustomerGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]
  leads         Lead[]
  quotations    Quotation[]
  orders        Order[]
  mailMessages  MailMessage[]
  waChats       WaChat[]
  aiMemories    AiMemory[]
  aiResearches  AiResearch[]
  shareVisits   ShareVisit[]
  socials       CustomerSocial[]
  socialPosts   SocialPost[]
  socialThreads SocialThread[]
  files         CrmFile[]
  shipments     Shipment[]

  @@unique([tenantId, nameKey])
  @@index([tenantId, ownerId])
  @@index([tenantId, domain])
  @@index([tenantId, poolDueAt])
}

/// 客群：保存的客户筛选条件。poolDays 非空时按该客群单独设置公海回收天数（0 = 不回收），按 sort 先匹配先生效
model CustomerSegment {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// 筛选条件，与客户列表 URL 参数同名
  filters     Json     @default("{}")
  /// 是否全公司可见；否则只有创建人可见
  shared      Boolean  @default(false)
  sort        Int      @default(0)
  poolDays    Int?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// 建档建议里被忽略的邮箱 / WhatsApp 号码。key 形如 mail:foo@bar.com、wa:8613800000000
model SuggestionIgnore {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  userId    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model Contact {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  name       String
  title      String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean  @default(false)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mailMessages MailMessage[]
  waChats      WaChat[]

  @@index([tenantId, email])
  @@index([customerId])
}

enum LeadStatus {
  NEW // 新线索
  QUALIFYING // 完善信息
  CONTACTED // 联系互动
  CONVERTED // 已转客户
  INVALID // 无效
}

/// 线索 / 询盘
model Lead {
  id            String     @id @default(cuid())
  tenantId      String
  companyName   String?
  contactName   String?
  email         String?
  phone         String?
  whatsapp      String?
  country       String?
  source        String?
  products      String?
  inquiry       String?
  status        LeadStatus @default(NEW)
  /// 无效原因（固定选项），补充说明见 invalidNote
  invalidReason String?
  invalidNote   String?
  invalidAt     DateTime?
  ownerId       String?
  assignedAt    DateTime?
  customerId    String?
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mailMessages MailMessage[]

  @@index([tenantId, status])
  @@index([tenantId, ownerId])
}

enum StageKind {
  OPEN
  WON
  LOST
}

/// 商机阶段（企业自定义）
model Stage {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  probability Int       @default(0)
  kind        StageKind @default(OPEN)
  sort        Int       @default(0)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([tenantId, name])
}

model Opportunity {
  id              String    @id @default(cuid())
  tenantId        String
  customerId      String
  name            String
  amount          Decimal   @default(0) @db.Decimal(14, 2)
  currency        String    @default("USD")
  stageId         String
  ownerId         String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  stageChangedAt  DateTime  @default(now())
  remark          String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage      Stage       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?       @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
  orders     Order[]

  @@index([tenantId, stageId])
  @@index([customerId])
}

enum ActivityType {
  FOLLOW_UP // 业务员写的跟进记录
  SYSTEM // 系统动态：创建、领取、放入公海、转移、阶段变更等
}

enum FollowMethod {
  EMAIL
  PHONE
  WHATSAPP
  WECHAT
  MEETING
  VISIT
  OTHER
}

/// 客户动态时间线
model Activity {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String?
  opportunityId String?
  type          ActivityType
  /// 系统事件类型：created / claimed / released / recycled / transferred / assigned / stage / opportunity / lead_converted
  event         String?
  method        FollowMethod?
  content       String
  userId        String?
  /// 同一件事合并成一条记录用的键（如分享链接被反复打开：share_view 对应 ShareVisit.refKey）
  refKey        String?
  createdAt     DateTime      @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, userId, event, createdAt])
  @@index([tenantId, refKey])
}

/// 客户打开我们发出的链接（报价单、表单、产品卡）的每一次访问，用于跟进记录和产品数据分析
model ShareVisit {
  id         String   @id @default(cuid())
  tenantId   String
  /// quotation 报价单 / inquiry 询价表单 / shipping 收货信息表单 / product 产品卡
  kind       String
  /// 报价单 id / 会话 id / 产品 id
  targetId   String
  /// 同一个链接发给同一个对象算一组，跟进记录按它合并
  refKey     String
  customerId String?
  /// WhatsApp 会话（表单、产品卡从会话里发出时）
  chatId     String?
  productId  String?
  /// 同一访客 30 分钟内的重复打开算同一次（IP + 浏览器的哈希）
  visitorKey String
  ip         String?
  country    String?
  region     String?
  city       String?
  /// mobile / tablet / desktop
  device     String?
  os         String?
  browser    String?
  ua         String?
  referrer   String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// 页面在前台的累计时长（毫秒）
  activeMs   Int      @default(0)
  /// 最深滚动到页面的百分比
  maxScroll  Int      @default(0)
  /// 各区块停留毫秒：{"gallery": 12000, "specs": 8000}
  sections   Json     @default("{}")
  /// 时间轴：[{t: 距开始毫秒, type: "open"|"section"|"click"|"hide"|"show", name?}]
  events     Json     @default("[]")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, refKey, startedAt])
  @@index([tenantId, productId, startedAt])
  @@index([tenantId, customerId, startedAt])
  @@index([tenantId, visitorKey, lastSeenAt])
}

/// 日程 / 跟进任务
model Task {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  dueAt         DateTime
  done          Boolean   @default(false)
  doneAt        DateTime?
  customerId    String?
  opportunityId String?
  ownerId       String
  createdById   String?
  /// 提醒场景（见 src/lib/reminders.ts）：factory_quote / logistics / payment ...，普通日程为空
  kind          String?
  /// 补充说明：在等谁、等什么、回来后要做什么
  note          String?
  /// 来源页面（报价单 / 订单 / 邮件等），提醒里一键跳回去
  link          String?
  /// 推迟过几次
  snoozeCount   Int       @default(0)
  createdAt     DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId, done, dueAt])
}

// ───────────────────────── P2 单据：产品、汇率、报价单、订单 ─────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
}

enum ProductStatus {
  ACTIVE // 在售
  INACTIVE // 停售
}

model Product {
  id               String        @id @default(cuid())
  tenantId         String
  /// 产品编号 / 货号，企业内唯一
  sku              String
  name             String
  /// 英文品名，报价单 / PI 上优先用它
  nameEn           String?
  categoryId       String?
  model            String?
  /// 规格描述（材质、尺寸、颜色等），会带到单据明细
  spec             String?
  unit             String        @default("pcs")
  price            Decimal       @default(0) @db.Decimal(14, 4)
  currency         String        @default("USD")
  /// 成本价（人民币），只在内部可见
  costPrice        Decimal?      @db.Decimal(14, 4)
  moq              Int?
  hsCode           String?
  /// 包装：每箱数量、外箱尺寸、毛重 / 净重（kg）
  cartonQty        Int?
  cartonSize       String?
  grossWeight      Decimal?      @db.Decimal(10, 3)
  netWeight        Decimal?      @db.Decimal(10, 3)
  /// 主图（列表缩略图、单据明细用）
  imageUrl         String?
  /// 更多图片（/api/files/... URL，最多 8 张）
  images           String[]      @default([])
  /// 产品视频
  videoUrl         String?
  status           ProductStatus @default(ACTIVE)
  remark           String?
  /// 产品卡（客户看到的页面）用的标题、卖点、详细描述、关键词，AI 可以帮忙优化
  listingTitle     String?
  bullets          String[]      @default([])
  listingDesc      String?
  keywords         String?
  listingUpdatedAt DateTime?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quotationItems QuotationItem[]
  orderItems     OrderItem[]
  visits         ShareVisit[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
}

/// 汇率：1 单位外币 = rate 人民币。单据保存时把当时的汇率快照下来。
model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  currency  String
  rate      Decimal  @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currency])
}

/// 审批状态（与单据业务状态分开记）。P7 审批流上线前都是 NONE
enum ApprovalStatus {
  NONE // 无需审批
  PENDING // 审批中
  APPROVED // 已通过
  REJECTED // 已驳回
}

enum QuotationStatus {
  DRAFT // 草稿
  APPROVED // 已批准
  SENT // 已发送
  ACCEPTED // 客户接受
  REJECTED // 客户拒绝
  EXPIRED // 已失效
  CONVERTED // 已转订单
}

model Quotation {
  id            String          @id @default(cuid())
  tenantId      String
  /// 单号，如 QT20261107-001
  no            String
  customerId    String
  opportunityId String?
  ownerId       String?
  status        QuotationStatus @default(DRAFT)
  approval      ApprovalStatus  @default(NONE)
  title         String?
  // 买方信息快照（打印用）
  buyerName     String
  buyerContact  String?
  buyerEmail    String?
  buyerPhone    String?
  buyerAddress  String?
  currency      String          @default("USD")
  /// 保存时的汇率快照：1 单位币种 = exchangeRate 人民币
  exchangeRate  Decimal         @default(1) @db.Decimal(14, 6)
  quoteDate     DateTime
  validUntil    DateTime?
  /// 贸易术语 FOB / CIF / EXW ...
  tradeTerm     String?
  port          String?
  paymentTerm   String?
  deliveryTime  String?
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discount      Decimal         @default(0) @db.Decimal(14, 2)
  shippingFee   Decimal         @default(0) @db.Decimal(14, 2)
  otherFee      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  terms         String?
  remark        String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User?           @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items       QuotationItem[]
  orders      Order[]

  @@unique([tenantId, no])
  @@index([tenantId, ownerId, createdAt])
  @@index([customerId])
}

/// 明细行是快照：产品后来改价或删除，不影响已开出的单据
model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  sort        Int     @default(0)
  sku         String?
  name        String
  spec        String?
  imageUrl    String?
  unit        String  @default("pcs")
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 4)
  amount      Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

enum OrderStatus {
  DRAFT // 草稿（不计业绩）
  CONFIRMED // 已确认
  PRODUCING // 生产中
  SHIPPED // 已发货
  AWAITING_PAYMENT // 待收款
  COMPLETED // 已完成
  AFTER_SALES // 售后
  CANCELLED // 已取消
}

model Order {
  id            String         @id @default(cuid())
  tenantId      String
  /// 单号，如 SO20261107-001；PI 号沿用它
  no            String
  customerId    String
  opportunityId String?
  quotationId   String?
  ownerId       String?
  status        OrderStatus    @default(CONFIRMED)
  approval      ApprovalStatus @default(NONE)
  buyerName     String
  buyerContact  String?
  buyerEmail    String?
  buyerPhone    String?
  buyerAddress  String?
  currency      String         @default("USD")
  exchangeRate  Decimal        @default(1) @db.Decimal(14, 6)
  orderDate     DateTime
  /// 交货期
  deliveryDate  DateTime?
  tradeTerm     String?
  port          String?
  paymentTerm   String?
  shippingMark  String?
  subtotal      Decimal        @default(0) @db.Decimal(14, 2)
  discount      Decimal        @default(0) @db.Decimal(14, 2)
  shippingFee   Decimal        @default(0) @db.Decimal(14, 2)
  otherFee      Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @default(0) @db.Decimal(14, 2)
  /// 已收款合计（随收款记录更新）
  paidAmount    Decimal        @default(0) @db.Decimal(14, 2)
  terms         String?
  remark        String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quotation   Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  owner       User?          @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    OrderPayment[]
  plans       PaymentPlan[]
  shipments   Shipment[]

  @@unique([tenantId, no])
  @@index([tenantId, ownerId, orderDate])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  sort      Int     @default(0)
  sku       String?
  name      String
  spec      String?
  imageUrl  String?
  unit      String  @default("pcs")
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 4)
  amount    Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// 收款记录（定金、尾款等）
model OrderPayment {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  /// 回款单号，如 RC20261117-001
  no          String?
  amount      Decimal  @db.Decimal(14, 2)
  /// 银行手续费 / 中转行扣费（订单币种），不计入已收
  fee         Decimal? @db.Decimal(14, 2)
  /// 付款方（和买方不一致时填，如代付公司）
  payer       String?
  receivedAt  DateTime
  method      String?
  remark      String?
  /// 水单 / 汇款凭证（客户资料里的文件）
  fileId      String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file   CrmFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ───────────────────────── P3 邮件 ─────────────────────────

enum MailAccountStatus {
  ACTIVE // 正常同步
  ERROR // 最近一次连接失败（lastError 有原因）
  PAUSED // 用户暂停同步
}

/// 业务员绑定的工作邮箱（IMAP 收 + SMTP 发）。密码用 APP_SECRET 加密存储。
model MailAccount {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String
  email         String
  displayName   String?
  imapHost      String
  imapPort      Int               @default(993)
  imapSecure    Boolean           @default(true)
  smtpHost      String
  smtpPort      Int               @default(465)
  smtpSecure    Boolean           @default(true)
  /// 登录名，通常就是邮箱地址
  username      String
  /// AES-256-GCM 加密后的密码 / 授权码
  passwordEnc   String
  signature     String?
  /// 陌生人来信（匹配不到客户）自动建成线索
  autoLead      Boolean           @default(true)
  status        MailAccountStatus @default(ACTIVE)
  lastError     String?
  lastSyncAt    DateTime?
  /// 各文件夹的同步进度：{ [path]: { uidValidity, lastUid } }
  syncState     Json              @default("{}")
  /// 同步租约：防止 worker 和「立即同步」同时跑
  syncLockUntil DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    MailMessage[]
  sequences   MailSequence[]
  enrollments MailEnrollment[]

  @@unique([tenantId, email])
  @@index([userId])
}

enum MailFolder {
  INBOX
  SENT
  /// 服务器上的垃圾邮件文件夹
  JUNK
}

/// 邮件。只同步收件箱和已发送；正文存纯文本和 HTML，附件存到上传目录。
model MailMessage {
  id           String     @id @default(cuid())
  tenantId     String
  accountId    String
  folder       MailFolder
  /// IMAP 文件夹路径 + UID，用于增量同步去重；本系统发出、尚未同步回来的邮件为空
  folderPath   String?
  uid          Int?
  messageId    String?
  inReplyTo    String?
  references   String[]
  fromAddr     String
  fromName     String?
  /// [{ name, address }]
  toList       Json       @default("[]")
  ccList       Json       @default("[]")
  subject      String     @default("")
  text         String?
  html         String?
  snippet      String     @default("")
  date         DateTime
  seen         Boolean    @default(false)
  starred      Boolean    @default(false)
  /// [{ id, filename, contentType, size }]，文件存在 UPLOAD_DIR/<tenantId>/mail/
  attachments  Json       @default("[]")
  /// 自动建档：匹配到的客户 / 联系人 / 线索
  customerId   String?
  contactId    String?
  leadId       String?
  // ── AI 分析（新来信自动跑） ──
  aiSummary    String?
  /// inquiry 询盘 / quotation 询价议价 / order 下单 / complaint 投诉 / logistics 物流 / payment 付款 / spam 推广 / other
  aiIntent     String?
  /// high / medium / low
  aiPriority   String?
  aiAnalyzedAt DateTime?
  /// 待办里标为「已处理」（不用回复）
  doneAt       DateTime?
  // ── 追踪（只有从系统发出的邮件有） ──
  /// 打开像素 / 链接跳转用的随机 ID
  trackId      String?    @unique
  openCount    Int        @default(0)
  openedAt     DateTime?
  lastOpenAt   DateTime?
  clickCount   Int        @default(0)
  /// 收到退信的时间
  bouncedAt    DateTime?
  /// 群发 / 跟进序列发出的
  enrollmentId String?
  createdAt    DateTime   @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    MailAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact    Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  enrollment MailEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  events     MailEvent[]

  @@unique([accountId, folderPath, uid])
  @@index([accountId, folder, date])
  @@index([tenantId, customerId, date])
  @@index([accountId, messageId])
}

// ───────────────────────── P4 WhatsApp（扫码登录） ─────────────────────────

enum WaStatus {
  DISCONNECTED // 未连接
  CONNECTING // 正在连接 / 等待扫码
  CONNECTED // 已连接
}

/// 业务员的 WhatsApp 号码。会话由 worker 维持，登录凭据存在 WA_AUTH_DIR/<id>/。
model WaAccount {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  /// 登录成功后的手机号（纯数字，含国家码）
  phone           String?
  name            String?
  status          WaStatus  @default(DISCONNECTED)
  /// 用户希望保持连接；点「断开」或「退出登录」后为 false
  enabled         Boolean   @default(true)
  /// 当前二维码字符串（CONNECTING 时）
  qr              String?
  qrAt            DateTime?
  /// 手机号配对码登录：要登录的手机号（纯数字，含国家码）；为空则用扫码登录
  pairPhone       String?
  /// worker 申请到的 8 位配对码
  pairCode        String?
  lastError       String?
  /// 用户点了「退出登录」，worker 需要注销并删除凭据
  logoutRequested Boolean   @default(false)
  connectedAt     DateTime?
  /// 关联后的历史消息同步：syncing / done；为空表示还没开始（重新登录后清空）
  syncStatus      String?
  /// 同步进度 0-100（WhatsApp 给的，可能为空）
  syncProgress    Int?
  /// 本轮同步已导入的消息数
  syncMessages    Int       @default(0)
  syncStartedAt   DateTime?
  syncDoneAt      DateTime?
  /// 自己的头像（存储 key），avatarAt 为上次拉取时间
  avatarKey       String?
  avatarAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats    WaChat[]
  messages WaMessage[]

  @@unique([userId])
}

/// 会话（单聊）。phone 用于匹配联系人的 WhatsApp / 电话。
model WaChat {
  id            String    @id @default(cuid())
  tenantId      String
  accountId     String
  jid           String
  phone         String?
  name          String?
  customerId    String?
  contactId     String?
  lastMessageAt DateTime?
  lastText      String?
  unread        Int       @default(0)
  /// 最后一条消息是不是我发的（列表里显示对勾）
  lastFromMe    Boolean   @default(false)
  /// 头像（存储 key）；avatarAt 为上次拉取时间，没头像时 key 为空但 avatarAt 有值
  avatarKey     String?
  avatarAt      DateTime?
  /// 置顶时间（为空表示没置顶），置顶的按置顶时间倒序排在最前
  pinnedAt      DateTime?
  /// 归档后不出现在主列表，在「已归档」里查看
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  WaAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact  Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages WaMessage[]

  @@unique([accountId, jid])
  @@index([tenantId, customerId])
  @@index([accountId, lastMessageAt])
}

enum WaMsgStatus {
  QUEUED // 待 worker 发送
  SENT
  FAILED
  RECEIVED
}

model WaMessage {
  id          String      @id @default(cuid())
  tenantId    String
  accountId   String
  chatId      String
  /// WhatsApp 消息 id，去重用；待发送的为空
  waId        String?
  fromMe      Boolean
  /// text / image / video / audio / document / sticker / other
  type        String      @default("text")
  body        String      @default("")
  /// 图片 / 视频 / 语音 / 文件：存储 key（<tenantId>/wa/<id>.<ext>），没下载到为空
  mediaKey    String?
  mediaMime   String?
  mediaName   String?
  mediaSize   Int?
  status      WaMsgStatus
  error       String?
  sentById    String?
  /// 回复的是哪条消息（本表 id）
  quotedId    String?
  /// 星标消息
  starred     Boolean     @default(false)
  /// 「为我删除」：只在本系统里隐藏，不影响手机和对方
  hiddenAt    DateTime?
  /// 译成中文的内容（对方发来的外文消息自动翻译）
  translation String?
  timestamp   DateTime
  createdAt   DateTime    @default(now())

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account WaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chat    WaChat    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([accountId, waId])
  @@index([chatId, timestamp])
  @@index([accountId, status])
}

// ───────────────────────── P4 AI ─────────────────────────

/// AI 生成结果缓存（客户背景速览、跟进建议），避免每次打开都重新生成
model AiInsight {
  id        String   @id @default(cuid())
  tenantId  String
  /// customer_brief / customer_next
  kind      String
  targetId  String
  content   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, targetId])
}

// ───────────────────────── 邮件营销：追踪、群发、跟进序列 ─────────────────────────

/// 邮件打开 / 点击记录
model MailEvent {
  id        String   @id @default(cuid())
  tenantId  String
  messageId String
  /// open / click
  type      String
  url       String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([tenantId, createdAt])
}

enum SequenceStatus {
  ACTIVE
  PAUSED
}

/// 群发 / 跟进序列：一封或多封邮件，按间隔天数依次发，客户回复或退信就停
model MailSequence {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  /// 用哪个邮箱发
  accountId   String
  ownerId     String
  status      SequenceStatus @default(ACTIVE)
  /// 每天最多发多少封（防止被邮箱服务商判为垃圾邮件）
  dailyLimit  Int            @default(100)
  /// 只在工作时间（企业时区 9–18 点）发
  workHours   Boolean        @default(true)
  stopOnReply Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     MailAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  steps       MailSequenceStep[]
  enrollments MailEnrollment[]

  @@index([tenantId, ownerId])
}

model MailSequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  sort       Int
  /// 距上一封（第一封为加入后）多少天
  delayDays  Int    @default(0)
  subject    String
  body       String

  sequence MailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, sort])
}

enum EnrollmentStatus {
  ACTIVE // 进行中
  COMPLETED // 全部发完
  REPLIED // 客户已回复
  BOUNCED // 退信
  UNSUBSCRIBED // 退订
  STOPPED // 手动停止
  FAILED // 发送失败
}

/// 序列里的一个收件人
model MailEnrollment {
  id         String           @id @default(cuid())
  tenantId   String
  sequenceId String
  accountId  String
  email      String
  name       String?
  company    String?
  country    String?
  customerId String?
  contactId  String?
  leadId     String?
  status     EnrollmentStatus @default(ACTIVE)
  /// 下一封是第几步（0 起）
  step       Int              @default(0)
  nextAt     DateTime?
  lastSentAt DateTime?
  repliedAt  DateTime?
  error      String?
  createdAt  DateTime         @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence MailSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  account  MailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages MailMessage[]

  @@unique([sequenceId, email])
  @@index([status, nextAt])
  @@index([tenantId, email])
}

/// 退订 / 硬退信名单：群发时自动跳过
model MailSuppression {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  /// unsubscribe / bounce / manual
  reason    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

/// 工作台情景模式：一组可拼装的组件布局（每人可存多个）
model Workspace {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  /// [{ id, type, size, params? }]，顺序即排列顺序
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// ───────────────────────── AI 记忆 ─────────────────────────

/// AI 对话：跨设备同步，长了以后旧的部分压成摘要
model AiThread {
  id          String   @id
  tenantId    String
  userId      String
  title       String
  /// 前端的对话轮次（原样存，图片只留缩略图）
  turns       Json
  /// 前 summaryUpTo 轮的摘要，给模型接着聊用
  summary     String?
  summaryUpTo Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, updatedAt])
}

/// AI 记住的东西。从不覆盖：改了就新建一版，旧的标 supersededById 并归档
model AiMemory {
  id             String    @id @default(cuid())
  tenantId       String
  /// personal = 只对本人；customer = 跟着客户（按客户的数据权限）；team = 全公司
  scope          String
  /// personal：本人；其他：谁让记的
  userId         String?
  customerId     String?
  /// fact 事实 / preference 偏好 / rule 规则 / decision 决定 / howto 做法
  kind           String
  /// 一句话说清楚，给人看
  title          String
  content        String
  /// user_said 用户亲口说的 / ai_found AI 自己发现的 / outside 从邮件、WhatsApp、网页里读来的
  source         String
  /// 可信：用户亲口说的、或有人确认过。不可信的只当参考，不能当规则
  trusted        Boolean   @default(false)
  /// user = 人写的 / ai = AI 写的（AI 不能覆盖人写的）
  createdByKind  String    @default("ai")
  /// active 生效 / proposed 待管理员确认（团队记忆）/ archived 已忘掉或过期 / superseded 被新版取代
  status         String    @default("active")
  pinned         Boolean   @default(false)
  /// 和另一条人写的记忆冲突，等人来定
  disputed       Boolean   @default(false)
  supersededById String?
  /// 合并时出现的次数
  recurrence     Int       @default(1)
  useCount       Int       @default(0)
  lastUsedAt     DateTime?
  /// 在哪段对话里记下的
  threadId       String?
  confirmedById  String?
  archivedAt     DateTime?
  /// 中英文检索关键词（客户邮件多是英文、用户用中文问，靠它跨语言匹配）
  keywords       String    @default("")
  /// 向量（配置了 EMBED_* 才有）；embedModel 记是哪个模型算的，换模型后重算
  embedding      Float[]
  embedModel     String?
  /// 从哪来的：mail:<id> / wa:<chatId> / thread:<id> / learn:<threadId> / promote:<ids>
  origin         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, status])
  @@index([tenantId, userId, status])
  @@index([tenantId, customerId, status])
}

/// AI 穿透：一次对客户公司的公开信息调查（官网、搜索、域名、注册信息、进口统计 + 我们自己的往来）
model AiResearch {
  id          String    @id @default(cuid())
  tenantId    String
  /// 对应的客户；在 AI 助手里查一家还不是客户的公司时为空
  customerId  String?
  /// 查的是什么：公司名 / 域名 / 邮箱
  query       String
  domain      String?
  /// running 进行中 / done 完成 / failed 失败
  status      String    @default("running")
  /// 各步进度：[{key,label,state:"wait"|"run"|"done"|"skip"|"fail",note?}]
  steps       Json      @default("[]")
  /// 报告：每一条都带来源、可信度
  report      Json?
  /// 0～100 匹配度
  score       Int?
  summary     String?
  error       String?
  createdById String?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, createdAt])
}

/// 客户的社媒账号：客户详情页显示成图标，点了直接打开；星级达到 Tenant.socialWatchStar 的客户由 worker 定时检查更新
model CustomerSocial {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String
  /// linkedin / facebook / instagram / youtube / tiktok / x / pinterest / vk / other，见 src/lib/social.ts
  platform    String
  url         String
  /// 账号名（@xxx、公司页名）
  handle      String?
  /// manual 手填 / research 穿透挖到
  source      String    @default("manual")
  /// 关掉后不跟踪（星级够也不查）
  watch       Boolean   @default(true)
  /// 公开订阅源（YouTube 频道、博客 RSS），找到了就按条目跟踪
  feedUrl     String?
  /// 主页内容摘要（没有订阅源时比对主页的标题 / 简介有没有变化）
  fingerprint String?
  checkedAt   DateTime?
  /// 最近一次发现更新
  changedAt   DateTime?
  /// 上次检查失败的原因（多数是要登录才能看）
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  posts    SocialPost[]

  @@unique([tenantId, customerId, url])
  @@index([tenantId, checkedAt])
}

/// 跟踪到的社媒更新（新视频 / 新文章 / 主页资料变了）
model SocialPost {
  id          String    @id @default(cuid())
  tenantId    String
  socialId    String
  customerId  String
  /// 订阅源条目 id；主页变化是 page:<摘要>
  externalId  String
  /// post 新内容 / profile 主页资料变化
  kind        String    @default("post")
  title       String
  url         String?
  summary     String?
  image       String?
  publishedAt DateTime
  /// 有人在「社媒动态」里点过已读
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  social   CustomerSocial @relation(fields: [socialId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([socialId, externalId])
  @@index([tenantId, publishedAt])
  @@index([tenantId, customerId, publishedAt])
}

/// 对外分享的聚合主页（Link-in-Bio）：每个销售一个（userId），分公司 / 部门一个（departmentId）
model BioPage {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?  @unique
  departmentId String?
  /// 公开地址 /b/<slug>，全站唯一
  slug         String   @unique
  title        String
  bio          String?
  avatar       String?
  /// 配色：sky / ink / sand / leaf
  theme        String   @default("sky")
  /// [{id, kind:"link"|"qr", platform, label, url, image?}]，按顺序显示
  links        Json     @default("[]")
  published    Boolean  @default(true)
  views        Int      @default(0)
  /// 各链接点击数 {linkId: n}
  clicks       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ── 社媒矩阵：代理 IP、托管账号、环境运行器任务、审计（docs/social-matrix-plan.md） ──

/// 代理 IP（手填）；保存后检测出口 IP / 国家 / 时区
model MatrixProxy {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  /// http / https / socks5
  protocol    String    @default("http")
  host        String
  port        Int
  username    String?
  /// 加密保存（src/server/crypto.ts）
  passwordEnc String?
  note        String?
  exitIp      String?
  country     String?
  countryCode String?
  city        String?
  timezone    String?
  isp         String?
  /// 机房 IP（容易被平台识别）
  hosting     Boolean?
  latencyMs   Int?
  checkedAt   DateTime?
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts MatrixAccount[]

  @@index([tenantId])
}

/// 托管的社媒账号：一个账号 = 一个固定指纹 + 一个代理 + 一个独立浏览器数据目录
model MatrixAccount {
  id          String    @id @default(cuid())
  tenantId    String
  /// linkedin / facebook / instagram / tiktok / youtube / x / reddit / pinterest / threads / vk / line
  platform    String
  name        String
  /// 分组（一个账号一个组）
  group       String?
  /// 标签（多个）
  tags        String[]  @default([])
  /// 登录用的邮箱 / 手机号（可不填）
  login       String?
  passwordEnc String?
  ownerId     String?
  proxyId     String?
  /// 指纹声称的系统：windows / macos
  os          String    @default("windows")
  /// 第一次启动时生成，之后每次都用这一份（不要改）
  fingerprint Json?
  /// new 未登录 / pending 等待登录 / active 已登录 / expired 登录失效 / restricted 受限
  status      String    @default("new")
  statusNote  String?
  loggedInAt  DateTime?
  checkedAt   DateTime?
  note        String?
  /// 收私信：开了才会定时同步这个账号的私信进收件箱
  inboxSync   Boolean   @default(false)
  /// 上次同步私信完成的时间（为空 = 还没同步过，第一次同步的消息不算未读）
  inboxAt     DateTime?
  /// 封面：运行器最近一次截的账号页面（存储里的 key）
  snapshotKey String?
  snapshotAt  DateTime?
  /// 浏览器环境放在哪台桌面软件上；为空 = 没有归属（企业开了云端就交给云端运行器）
  deviceId    String?
  /// 桌面版常驻监听这个账号的最近心跳（90 秒内 = 实时收私信中，服务器不再排定时同步）
  watchedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner   User?          @relation("MatrixAccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  device  MatrixDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  proxy   MatrixProxy?   @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  jobs    MatrixJob[]
  events  MatrixEvent[]
  threads SocialThread[]

  @@index([tenantId, platform])
}

/// 环境运行器的任务队列
model MatrixJob {
  id          String    @id @default(cuid())
  tenantId    String
  accountId   String
  /// login 登录 / open 打开环境 / check 检查登录状态（之后：inbox / reply / publish）
  kind        String
  payload     Json?
  /// queued / running / waiting（等人登录）/ done / failed / canceled
  status      String    @default("queued")
  result      Json?
  error       String?
  /// 哪台运行器在跑
  runner      String?
  /// 运行中的进度说明（如「上传 1/2 块」）
  progress    String?
  createdById String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account MatrixAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId, accountId, createdAt])
}

/// 审计：谁对哪个账号做了什么
model MatrixEvent {
  id        String   @id @default(cuid())
  tenantId  String
  accountId String
  userId    String?
  action    String
  detail    String?
  runner    String?
  createdAt DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account MatrixAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId, createdAt])
}

/// 云端运行器用量：按月累计运行时长（运行器心跳之间的间隔相加）
model MatrixUsage {
  tenantId     String
  /// YYYY-MM（香港时间）
  month        String
  cloudSeconds Int      @default(0)
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, month])
}

/// 环境运行器心跳（tenantId 为空 = 服务所有企业的服务器运行器）
/// 装了桌面软件的电脑。登录 CRM 后自动配对，拿设备令牌领归属自己的账号的任务
model MatrixDevice {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  /// 「Louis 的 MacBook Pro」
  name       String
  os         String?
  appVersion String?
  /// 设备令牌 md_… 的 sha256，明文只在配对时返回一次
  tokenHash  String    @unique
  lastSeenAt DateTime?
  /// 桌面版报上来的状态（如「正在下载浏览器内核 41%」），正常运行时为空
  statusNote String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts MatrixAccount[]

  @@index([tenantId])
  @@index([userId])
}

model MatrixRunner {
  id         String   @id
  tenantId   String?
  host       String
  version    String?
  /// 正在跑的任务数
  busy       Int      @default(0)
  lastSeenAt DateTime @default(now())

  @@index([tenantId, lastSeenAt])
}

// ───────────────────────── 社媒收件箱 ─────────────────────────

/// 社媒私信会话：矩阵账号和一个对方用户的对话（运行器同步进来）
model SocialThread {
  id            String    @id @default(cuid())
  tenantId      String
  accountId     String
  /// 和账号同一个平台（冗余，筛选用）
  platform      String
  /// 平台上的会话标识（会话链接里的 id；没有时用对方名字）
  externalId    String
  /// 打开这个会话的网址（运行器回复时用）
  url           String?
  peerName      String?
  /// 对方的 @用户名
  peerHandle    String?
  /// 对方主页链接
  peerUrl       String?
  peerAvatar    String?
  /// 对方语言（谷歌识别出的语言代码，回复时译成这个）
  peerLang      String?
  customerId    String?
  leadId        String?
  /// 分给谁处理（默认账号负责人）
  assigneeId    String?
  lastMessageAt DateTime?
  lastText      String?
  lastFromMe    Boolean   @default(false)
  unread        Int       @default(0)
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  MatrixAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee User?           @relation("SocialThreadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages SocialMessage[]

  @@unique([accountId, externalId])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, assigneeId])
  @@index([tenantId, customerId])
}

/// 社媒私信消息
model SocialMessage {
  id          String   @id @default(cuid())
  tenantId    String
  threadId    String
  /// 去重用：平台消息 id，没有时用内容摘要；CRM 里发出、还没同步回来的为空
  externalId  String?
  fromMe      Boolean
  /// text / image / video / other
  type        String   @default("text")
  body        String   @default("")
  /// received 收到 / queued 待发送 / sending 发送中 / sent 已发送 / failed 发送失败
  status      String
  error       String?
  sentById    String?
  /// 收到的：译成中文；发出的：翻译前的中文原文
  translation String?
  timestamp   DateTime
  createdAt   DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thread SocialThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, externalId])
  @@index([threadId, timestamp])
  @@index([tenantId, status])
}

/// 快捷回复话术（收件箱、WhatsApp 共用）
model QuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  /// 分组（如「报价」「物流」）
  group     String?
  title     String
  /// 正文，可用变量 {客户名} {联系人} {我的名字} {公司}
  body      String
  /// 为空 = 全公司共用；有值 = 个人话术
  ownerId   String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId])
}

/// 文件：客户资料里的 PI、CI、CO、装箱单、合同等；customerId 为空 = 发给 AI 看的临时文件（只有上传人能看）
model CrmFile {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  /// PI / CI / PL / CO / BL / CONTRACT / QUOTE / CERT / PHOTO / OTHER
  category    String   @default("OTHER")
  name        String
  mime        String
  size        Int
  /// 存储 key：<tenantId>/files/<id>.<ext>
  key         String
  /// 抽出来的文字（给 AI 读、全文搜索），太长的截断
  text        String?
  /// 抽文字的情况：ok / empty（扫描件等没文字） / failed / skip（图片、视频）
  textState   String   @default("skip")
  note        String?
  /// upload / ai / whatsapp / mail
  source      String   @default("upload")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments  OrderPayment[]

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, createdById])
}

// ───────────────────────── 回款计划 / 物流 / 审批 / 操作日志 ─────────────────────────

/// 订单的收款计划（定金、尾款…）：用来算应收账龄、逾期提醒。已收金额按到期日先后依次冲抵
model PaymentPlan {
  id         String    @id @default(cuid())
  tenantId   String
  orderId    String
  sort       Int       @default(0)
  /// 定金 / 尾款 / 见提单副本付款…
  label      String
  amount     Decimal   @db.Decimal(14, 2)
  dueDate    DateTime
  /// 上次发逾期提醒的时间（每 7 天最多提醒一次）
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate])
  @@index([orderId])
}

enum ShipmentStatus {
  BOOKING // 待订舱
  BOOKED // 已订舱
  LOADED // 已装柜 / 已提货
  DEPARTED // 已开船 / 已起飞
  ARRIVED // 已到港
  DELIVERED // 已签收
  CANCELLED // 已取消
}

/// 发货批次：一个订单可以分批发
model Shipment {
  id            String         @id @default(cuid())
  tenantId      String
  orderId       String
  customerId    String
  /// 批次号，如 SH20261117-001
  no            String
  status        ShipmentStatus @default(BOOKING)
  /// sea 海运 / air 空运 / express 快递 / rail 铁路 / truck 陆运
  mode          String         @default("sea")
  /// 货代
  forwarder     String?
  /// 船公司 / 航空公司 / 快递公司
  carrier       String?
  bookingNo     String?
  /// 提单号 / 空运单号
  blNo          String?
  /// 柜号，多个用逗号分隔
  containerNo   String?
  /// 20GP / 40HQ / LCL…
  containerType String?
  sealNo        String?
  /// 船名航次 / 航班号
  vessel        String?
  /// 快递单号
  trackingNo    String?
  /// 自己填的跟踪链接（没有内置船司 / 快递时用）
  trackingUrl   String?
  portLoading   String?
  portDischarge String?
  /// 件数、毛重（kg）、体积（CBM）
  packages      Int?
  grossWeight   Decimal?       @db.Decimal(12, 3)
  volume        Decimal?       @db.Decimal(10, 3)
  /// 截关 / 截单时间
  cutoffAt      DateTime?
  etd           DateTime?
  eta           DateTime?
  /// 实际开船 / 到港 / 签收
  atd           DateTime?
  ata           DateTime?
  deliveredAt   DateTime?
  /// 运费（成本，内部可见）
  freight       Decimal?       @db.Decimal(14, 2)
  freightCcy    String?
  remark        String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events   ShipmentEvent[]

  @@unique([tenantId, no])
  @@index([tenantId, status, eta])
  @@index([orderId])
  @@index([customerId])
}

/// 物流节点：状态变化和手写的进展
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  /// 变成了哪个状态；手写进展为空
  status     String?
  at         DateTime
  note       String?
  userId     String?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, at])
}

/// 审批单：报价单 / 订单折扣、退公海、删除客户、转移客户
model ApprovalRequest {
  id          String         @id @default(cuid())
  tenantId    String
  /// quotation / order / customer_release / customer_delete / customer_transfer
  kind        String
  status      ApprovalStatus @default(PENDING)
  /// 报价单 / 订单 id；客户批量操作时为空（id 在 payload 里）
  targetId    String?
  /// 一句话说明：报价单 QT-001 折扣 18%
  title       String
  /// 执行需要的参数（客户 id、转给谁、原因…）
  payload     Json?
  /// 申请人写的理由
  reason      String?
  requesterId String
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, requesterId, createdAt])
  @@index([tenantId, kind, targetId])
}

/// 操作日志：谁在什么时候改了什么（只增不改）
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  /// 当时的名字（人删了也看得到）
  userName   String?
  /// create / update / delete / transfer / release / claim / assign / status / approve / reject / login …
  action     String
  /// customer / contact / quotation / order / payment / shipment / file / member / role / department / settings / approval / user
  entity     String
  entityId   String?
  entityName String?
  /// 一句话：把客户 ABC 转给了张三
  summary    String
  /// 改了哪些字段：{ 字段: [旧, 新] } 等
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId, createdAt])
}
