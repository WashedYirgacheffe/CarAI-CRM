// 车车外贸 CRM — 数据模型
// 约定：所有业务表都带 tenantId，通过 src/server/db.ts 的 tenantDb() 自动隔离。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 企业（租户）。注册时创建，一个企业对应一个主账号。
model Tenant {
  id                   String   @id @default(cuid())
  name                 String
  defaultCurrency      String   @default("USD")
  timezone             String   @default("Asia/Shanghai")
  /// 公海规则：负责人超过 N 天未跟进，客户自动回到公海（0 = 不自动回收）
  poolRecycleDays      Int      @default(30)
  /// 每人每天最多从公海领取的客户数（0 = 不限）
  poolDailyClaimLimit  Int      @default(20)
  /// 每人最多持有的私海客户数（0 = 不限）
  privateCustomerLimit Int      @default(0)
  /// 公海回收依据：contact = 最近联系（收发邮件、WhatsApp、跟进都算）；follow = 最近跟进（销售手写的跟进）
  poolBasis            String   @default("contact")
  /// 进公海前 N 天给负责人建提醒任务（0 = 不提醒）
  poolWarnDays         Int      @default(7)
  // ── 单据抬头（报价单 / PI 上显示，英文） ──
  docCompanyName       String?
  docAddress           String?
  docPhone             String?
  docEmail             String?
  docWebsite           String?
  /// 收款银行信息，原样打印在 PI 上
  docBankInfo          String?
  /// 报价单默认条款
  docQuotationTerms    String?
  /// 报价单默认有效期（天）
  quotationValidDays   Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users             User[]
  departments       Department[]
  roles             Role[]
  customers         Customer[]
  statuses          CustomerStatus[]
  groups            CustomerGroup[]
  contacts          Contact[]
  leads             Lead[]
  stages            Stage[]
  opportunities     Opportunity[]
  activities        Activity[]
  tasks             Task[]
  productCategories ProductCategory[]
  products          Product[]
  exchangeRates     ExchangeRate[]
  quotations        Quotation[]
  orders            Order[]
  orderPayments     OrderPayment[]
  mailAccounts      MailAccount[]
  mailMessages      MailMessage[]
  waAccounts        WaAccount[]
  waChats           WaChat[]
  waMessages        WaMessage[]
  aiInsights        AiInsight[]
  segments          CustomerSegment[]
  suggestionIgnores SuggestionIgnore[]
  mailSequences     MailSequence[]
  mailEnrollments   MailEnrollment[]
  mailEvents        MailEvent[]
  mailSuppressions  MailSuppression[]
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// 账号。isOwner = 主账号（企业创建者，不可被禁用/删除）。
model User {
  id             String     @id @default(cuid())
  tenantId       String
  email          String     @unique
  name           String
  phone          String?
  passwordHash   String
  isOwner        Boolean    @default(false)
  status         UserStatus @default(ACTIVE)
  departmentId   String?
  roleId         String
  lastLoginAt    DateTime?
  /// 工作台卡片（顺序即显示顺序）；空数组表示用默认布局
  dashboardCards String[]   @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions   Session[]

  ownedCustomers     Customer[]    @relation("CustomerOwner")
  prevCustomers      Customer[]    @relation("CustomerPrevOwner")
  ownedLeads         Lead[]        @relation("LeadOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  activities         Activity[]
  tasks              Task[]        @relation("TaskOwner")
  ownedQuotations    Quotation[]   @relation("QuotationOwner")
  ownedOrders        Order[]       @relation("OrderOwner")
  mailAccounts       MailAccount[]
  waAccounts         WaAccount[]

  @@index([tenantId])
}

/// 登录会话。id 是 token 的 SHA-256，数据库里不存明文 token。
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 部门，树形结构。根部门在注册时以企业名创建。
model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentTree")
  users    User[]

  @@index([tenantId])
}

/// 数据范围：决定一个角色能看到哪些客户/商机等业务数据。
enum DataScope {
  SELF // 仅本人
  DEPARTMENT // 本部门（含下级部门）
  ALL // 全公司
}

/// 角色。permissions 是权限点 key 列表，定义见 src/lib/permissions.ts。
model Role {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  /// 系统内置角色的标识（admin / manager / sales），自定义角色为空
  systemKey   String?
  permissions String[]
  dataScope   DataScope @default(SELF)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ================= P1：客户与销售 =================

/// 客户状态（企业自定义，如：询盘客户、样品客户、成交客户）
model CustomerStatus {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String @default("slate")
  sort     Int    @default(0)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([tenantId, name])
}

/// 客户分组，最多 3 级
model CustomerGroup {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  parentId String?
  sort     Int     @default(0)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    CustomerGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  CustomerGroup[] @relation("GroupTree")
  customers Customer[]

  @@index([tenantId])
}

/// 客户（公司）。ownerId 为空 = 在公海。
model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  /// 规范化名称（小写、去空格和标点、去公司后缀），企业内唯一，用于防撞单
  nameKey       String
  country       String?
  website       String?
  /// 官网或邮箱域名，用于查重和邮件自动匹配
  domain        String?
  address       String?
  source        String?
  customerType  String?
  mainProducts  String?
  annualVolume  String?
  star          Int       @default(0)
  statusId      String?
  groupId       String?
  tags          String[]
  remark        String?
  ownerId       String?
  assignedAt    DateTime?
  /// 最近联系：任何往来（收发邮件、WhatsApp、跟进）
  lastContactAt  DateTime?
  /// 最近跟进：销售手写的跟进记录
  lastFollowAt   DateTime?
  lastMailRecvAt DateTime?
  lastMailSentAt DateTime?
  lastWaAt       DateTime?
  nextFollowAt   DateTime?
  poolEnteredAt  DateTime?
  poolReason     String?
  /// 累计进入公海次数
  poolCount      Int       @default(0)
  /// 上一任负责人（进公海或转移前）
  prevOwnerId    String?
  /// 按公海规则算出的下次自动进公海时间（worker 每小时刷新）
  poolDueAt      DateTime?
  /// 已发过进公海提醒的时间；下次进公海时间推后会清空
  poolWarnedAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?           @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  prevOwner     User?           @relation("CustomerPrevOwner", fields: [prevOwnerId], references: [id], onDelete: SetNull)
  status        CustomerStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  group         CustomerGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]
  leads         Lead[]
  quotations    Quotation[]
  orders        Order[]
  mailMessages  MailMessage[]
  waChats       WaChat[]

  @@unique([tenantId, nameKey])
  @@index([tenantId, ownerId])
  @@index([tenantId, domain])
  @@index([tenantId, poolDueAt])
}

/// 客群：保存的客户筛选条件。poolDays 非空时按该客群单独设置公海回收天数（0 = 不回收），按 sort 先匹配先生效
model CustomerSegment {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// 筛选条件，与客户列表 URL 参数同名
  filters     Json     @default("{}")
  /// 是否全公司可见；否则只有创建人可见
  shared      Boolean  @default(false)
  sort        Int      @default(0)
  poolDays    Int?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// 建档建议里被忽略的邮箱 / WhatsApp 号码。key 形如 mail:foo@bar.com、wa:8613800000000
model SuggestionIgnore {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  userId    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model Contact {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  name       String
  title      String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean  @default(false)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mailMessages MailMessage[]
  waChats      WaChat[]

  @@index([tenantId, email])
  @@index([customerId])
}

enum LeadStatus {
  NEW // 新线索
  QUALIFYING // 完善信息
  CONTACTED // 联系互动
  CONVERTED // 已转客户
  INVALID // 无效
}

/// 线索 / 询盘
model Lead {
  id            String     @id @default(cuid())
  tenantId      String
  companyName   String?
  contactName   String?
  email         String?
  phone         String?
  whatsapp      String?
  country       String?
  source        String?
  products      String?
  inquiry       String?
  status        LeadStatus @default(NEW)
  /// 无效原因（固定选项），补充说明见 invalidNote
  invalidReason String?
  invalidNote   String?
  invalidAt     DateTime?
  ownerId       String?
  assignedAt    DateTime?
  customerId    String?
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mailMessages MailMessage[]

  @@index([tenantId, status])
  @@index([tenantId, ownerId])
}

enum StageKind {
  OPEN
  WON
  LOST
}

/// 商机阶段（企业自定义）
model Stage {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  probability Int       @default(0)
  kind        StageKind @default(OPEN)
  sort        Int       @default(0)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([tenantId, name])
}

model Opportunity {
  id              String    @id @default(cuid())
  tenantId        String
  customerId      String
  name            String
  amount          Decimal   @default(0) @db.Decimal(14, 2)
  currency        String    @default("USD")
  stageId         String
  ownerId         String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  stageChangedAt  DateTime  @default(now())
  remark          String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage      Stage       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?       @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]
  quotations Quotation[]
  orders     Order[]

  @@index([tenantId, stageId])
  @@index([customerId])
}

enum ActivityType {
  FOLLOW_UP // 业务员写的跟进记录
  SYSTEM // 系统动态：创建、领取、放入公海、转移、阶段变更等
}

enum FollowMethod {
  EMAIL
  PHONE
  WHATSAPP
  WECHAT
  MEETING
  VISIT
  OTHER
}

/// 客户动态时间线
model Activity {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String?
  opportunityId String?
  type          ActivityType
  /// 系统事件类型：created / claimed / released / recycled / transferred / assigned / stage / opportunity / lead_converted
  event         String?
  method        FollowMethod?
  content       String
  userId        String?
  createdAt     DateTime      @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, userId, event, createdAt])
}

/// 日程 / 跟进任务
model Task {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  dueAt         DateTime
  done          Boolean   @default(false)
  doneAt        DateTime?
  customerId    String?
  opportunityId String?
  ownerId       String
  createdById   String?
  /// 提醒场景（见 src/lib/reminders.ts）：factory_quote / logistics / payment ...，普通日程为空
  kind          String?
  /// 补充说明：在等谁、等什么、回来后要做什么
  note          String?
  /// 来源页面（报价单 / 订单 / 邮件等），提醒里一键跳回去
  link          String?
  /// 推迟过几次
  snoozeCount   Int       @default(0)
  createdAt     DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId, done, dueAt])
}

// ───────────────────────── P2 单据：产品、汇率、报价单、订单 ─────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
}

enum ProductStatus {
  ACTIVE // 在售
  INACTIVE // 停售
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  /// 产品编号 / 货号，企业内唯一
  sku         String
  name        String
  /// 英文品名，报价单 / PI 上优先用它
  nameEn      String?
  categoryId  String?
  model       String?
  /// 规格描述（材质、尺寸、颜色等），会带到单据明细
  spec        String?
  unit        String        @default("pcs")
  price       Decimal       @default(0) @db.Decimal(14, 4)
  currency    String        @default("USD")
  /// 成本价（人民币），只在内部可见
  costPrice   Decimal?      @db.Decimal(14, 4)
  moq         Int?
  hsCode      String?
  /// 包装：每箱数量、外箱尺寸、毛重 / 净重（kg）
  cartonQty   Int?
  cartonSize  String?
  grossWeight Decimal?      @db.Decimal(10, 3)
  netWeight   Decimal?      @db.Decimal(10, 3)
  /// 主图（列表缩略图、单据明细用）
  imageUrl    String?
  /// 更多图片（/api/files/... URL，最多 8 张）
  images      String[]      @default([])
  /// 产品视频
  videoUrl    String?
  status      ProductStatus @default(ACTIVE)
  remark      String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quotationItems QuotationItem[]
  orderItems     OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
}

/// 汇率：1 单位外币 = rate 人民币。单据保存时把当时的汇率快照下来。
model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  currency  String
  rate      Decimal  @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currency])
}

/// 审批状态（与单据业务状态分开记）。P7 审批流上线前都是 NONE
enum ApprovalStatus {
  NONE // 无需审批
  PENDING // 审批中
  APPROVED // 已通过
  REJECTED // 已驳回
}

enum QuotationStatus {
  DRAFT // 草稿
  APPROVED // 已批准
  SENT // 已发送
  ACCEPTED // 客户接受
  REJECTED // 客户拒绝
  EXPIRED // 已失效
  CONVERTED // 已转订单
}

model Quotation {
  id            String          @id @default(cuid())
  tenantId      String
  /// 单号，如 QT20261107-001
  no            String
  customerId    String
  opportunityId String?
  ownerId       String?
  status        QuotationStatus @default(DRAFT)
  approval      ApprovalStatus  @default(NONE)
  title         String?
  // 买方信息快照（打印用）
  buyerName     String
  buyerContact  String?
  buyerEmail    String?
  buyerPhone    String?
  buyerAddress  String?
  currency      String          @default("USD")
  /// 保存时的汇率快照：1 单位币种 = exchangeRate 人民币
  exchangeRate  Decimal         @default(1) @db.Decimal(14, 6)
  quoteDate     DateTime
  validUntil    DateTime?
  /// 贸易术语 FOB / CIF / EXW ...
  tradeTerm     String?
  port          String?
  paymentTerm   String?
  deliveryTime  String?
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discount      Decimal         @default(0) @db.Decimal(14, 2)
  shippingFee   Decimal         @default(0) @db.Decimal(14, 2)
  otherFee      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  terms         String?
  remark        String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User?           @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items       QuotationItem[]
  orders      Order[]

  @@unique([tenantId, no])
  @@index([tenantId, ownerId, createdAt])
  @@index([customerId])
}

/// 明细行是快照：产品后来改价或删除，不影响已开出的单据
model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  sort        Int     @default(0)
  sku         String?
  name        String
  spec        String?
  imageUrl    String?
  unit        String  @default("pcs")
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 4)
  amount      Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

enum OrderStatus {
  DRAFT // 草稿（不计业绩）
  CONFIRMED // 已确认
  PRODUCING // 生产中
  SHIPPED // 已发货
  AWAITING_PAYMENT // 待收款
  COMPLETED // 已完成
  AFTER_SALES // 售后
  CANCELLED // 已取消
}

model Order {
  id            String         @id @default(cuid())
  tenantId      String
  /// 单号，如 SO20261107-001；PI 号沿用它
  no            String
  customerId    String
  opportunityId String?
  quotationId   String?
  ownerId       String?
  status        OrderStatus    @default(CONFIRMED)
  approval      ApprovalStatus @default(NONE)
  buyerName     String
  buyerContact  String?
  buyerEmail    String?
  buyerPhone    String?
  buyerAddress  String?
  currency      String         @default("USD")
  exchangeRate  Decimal        @default(1) @db.Decimal(14, 6)
  orderDate     DateTime
  /// 交货期
  deliveryDate  DateTime?
  tradeTerm     String?
  port          String?
  paymentTerm   String?
  shippingMark  String?
  subtotal      Decimal        @default(0) @db.Decimal(14, 2)
  discount      Decimal        @default(0) @db.Decimal(14, 2)
  shippingFee   Decimal        @default(0) @db.Decimal(14, 2)
  otherFee      Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @default(0) @db.Decimal(14, 2)
  /// 已收款合计（随收款记录更新）
  paidAmount    Decimal        @default(0) @db.Decimal(14, 2)
  terms         String?
  remark        String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quotation   Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  owner       User?          @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    OrderPayment[]

  @@unique([tenantId, no])
  @@index([tenantId, ownerId, orderDate])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  sort      Int     @default(0)
  sku       String?
  name      String
  spec      String?
  imageUrl  String?
  unit      String  @default("pcs")
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 4)
  amount    Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// 收款记录（定金、尾款等）
model OrderPayment {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  amount      Decimal  @db.Decimal(14, 2)
  receivedAt  DateTime
  method      String?
  remark      String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ───────────────────────── P3 邮件 ─────────────────────────

enum MailAccountStatus {
  ACTIVE // 正常同步
  ERROR // 最近一次连接失败（lastError 有原因）
  PAUSED // 用户暂停同步
}

/// 业务员绑定的工作邮箱（IMAP 收 + SMTP 发）。密码用 APP_SECRET 加密存储。
model MailAccount {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String
  email         String
  displayName   String?
  imapHost      String
  imapPort      Int               @default(993)
  imapSecure    Boolean           @default(true)
  smtpHost      String
  smtpPort      Int               @default(465)
  smtpSecure    Boolean           @default(true)
  /// 登录名，通常就是邮箱地址
  username      String
  /// AES-256-GCM 加密后的密码 / 授权码
  passwordEnc   String
  signature     String?
  /// 陌生人来信（匹配不到客户）自动建成线索
  autoLead      Boolean           @default(true)
  status        MailAccountStatus @default(ACTIVE)
  lastError     String?
  lastSyncAt    DateTime?
  /// 各文件夹的同步进度：{ [path]: { uidValidity, lastUid } }
  syncState     Json              @default("{}")
  /// 同步租约：防止 worker 和「立即同步」同时跑
  syncLockUntil DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    MailMessage[]
  sequences   MailSequence[]
  enrollments MailEnrollment[]

  @@unique([tenantId, email])
  @@index([userId])
}

enum MailFolder {
  INBOX
  SENT
}

/// 邮件。只同步收件箱和已发送；正文存纯文本和 HTML，附件存到上传目录。
model MailMessage {
  id           String     @id @default(cuid())
  tenantId     String
  accountId    String
  folder       MailFolder
  /// IMAP 文件夹路径 + UID，用于增量同步去重；本系统发出、尚未同步回来的邮件为空
  folderPath   String?
  uid          Int?
  messageId    String?
  inReplyTo    String?
  references   String[]
  fromAddr     String
  fromName     String?
  /// [{ name, address }]
  toList       Json       @default("[]")
  ccList       Json       @default("[]")
  subject      String     @default("")
  text         String?
  html         String?
  snippet      String     @default("")
  date         DateTime
  seen         Boolean    @default(false)
  starred      Boolean    @default(false)
  /// [{ id, filename, contentType, size }]，文件存在 UPLOAD_DIR/<tenantId>/mail/
  attachments  Json       @default("[]")
  /// 自动建档：匹配到的客户 / 联系人 / 线索
  customerId   String?
  contactId    String?
  leadId       String?
  // ── AI 分析（新来信自动跑） ──
  aiSummary    String?
  /// inquiry 询盘 / quotation 询价议价 / order 下单 / complaint 投诉 / logistics 物流 / payment 付款 / spam 推广 / other
  aiIntent     String?
  /// high / medium / low
  aiPriority   String?
  aiAnalyzedAt DateTime?
  // ── 追踪（只有从系统发出的邮件有） ──
  /// 打开像素 / 链接跳转用的随机 ID
  trackId      String?    @unique
  openCount    Int        @default(0)
  openedAt     DateTime?
  lastOpenAt   DateTime?
  clickCount   Int        @default(0)
  /// 收到退信的时间
  bouncedAt    DateTime?
  /// 群发 / 跟进序列发出的
  enrollmentId String?
  createdAt    DateTime   @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact  Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  enrollment MailEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  events     MailEvent[]

  @@unique([accountId, folderPath, uid])
  @@index([accountId, folder, date])
  @@index([tenantId, customerId, date])
  @@index([accountId, messageId])
}

// ───────────────────────── P4 WhatsApp（扫码登录） ─────────────────────────

enum WaStatus {
  DISCONNECTED // 未连接
  CONNECTING // 正在连接 / 等待扫码
  CONNECTED // 已连接
}

/// 业务员的 WhatsApp 号码。会话由 worker 维持，登录凭据存在 WA_AUTH_DIR/<id>/。
model WaAccount {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  /// 登录成功后的手机号（纯数字，含国家码）
  phone           String?
  name            String?
  status          WaStatus  @default(DISCONNECTED)
  /// 用户希望保持连接；点「断开」或「退出登录」后为 false
  enabled         Boolean   @default(true)
  /// 当前二维码字符串（CONNECTING 时）
  qr              String?
  qrAt            DateTime?
  /// 手机号配对码登录：要登录的手机号（纯数字，含国家码）；为空则用扫码登录
  pairPhone       String?
  /// worker 申请到的 8 位配对码
  pairCode        String?
  lastError       String?
  /// 用户点了「退出登录」，worker 需要注销并删除凭据
  logoutRequested Boolean   @default(false)
  connectedAt     DateTime?
  /// 关联后的历史消息同步：syncing / done；为空表示还没开始（重新登录后清空）
  syncStatus      String?
  /// 同步进度 0-100（WhatsApp 给的，可能为空）
  syncProgress    Int?
  /// 本轮同步已导入的消息数
  syncMessages    Int       @default(0)
  syncStartedAt   DateTime?
  syncDoneAt      DateTime?
  /// 自己的头像（存储 key），avatarAt 为上次拉取时间
  avatarKey       String?
  avatarAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats    WaChat[]
  messages WaMessage[]

  @@unique([userId])
}

/// 会话（单聊）。phone 用于匹配联系人的 WhatsApp / 电话。
model WaChat {
  id            String    @id @default(cuid())
  tenantId      String
  accountId     String
  jid           String
  phone         String?
  name          String?
  customerId    String?
  contactId     String?
  lastMessageAt DateTime?
  lastText      String?
  unread        Int       @default(0)
  /// 最后一条消息是不是我发的（列表里显示对勾）
  lastFromMe    Boolean   @default(false)
  /// 头像（存储 key）；avatarAt 为上次拉取时间，没头像时 key 为空但 avatarAt 有值
  avatarKey     String?
  avatarAt      DateTime?
  createdAt     DateTime  @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  WaAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact  Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages WaMessage[]

  @@unique([accountId, jid])
  @@index([tenantId, customerId])
  @@index([accountId, lastMessageAt])
}

enum WaMsgStatus {
  QUEUED // 待 worker 发送
  SENT
  FAILED
  RECEIVED
}

model WaMessage {
  id        String      @id @default(cuid())
  tenantId  String
  accountId String
  chatId    String
  /// WhatsApp 消息 id，去重用；待发送的为空
  waId      String?
  fromMe    Boolean
  /// text / image / video / audio / document / sticker / other
  type      String      @default("text")
  body      String      @default("")
  /// 图片 / 视频 / 语音 / 文件：存储 key（<tenantId>/wa/<id>.<ext>），没下载到为空
  mediaKey  String?
  mediaMime String?
  mediaName String?
  mediaSize Int?
  status    WaMsgStatus
  error     String?
  sentById  String?
  timestamp DateTime
  createdAt DateTime    @default(now())

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account WaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chat    WaChat    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([accountId, waId])
  @@index([chatId, timestamp])
  @@index([accountId, status])
}

// ───────────────────────── P4 AI ─────────────────────────

/// AI 生成结果缓存（客户背景速览、跟进建议），避免每次打开都重新生成
model AiInsight {
  id        String   @id @default(cuid())
  tenantId  String
  /// customer_brief / customer_next
  kind      String
  targetId  String
  content   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, targetId])
}

// ───────────────────────── 邮件营销：追踪、群发、跟进序列 ─────────────────────────

/// 邮件打开 / 点击记录
model MailEvent {
  id        String   @id @default(cuid())
  tenantId  String
  messageId String
  /// open / click
  type      String
  url       String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([tenantId, createdAt])
}

enum SequenceStatus {
  ACTIVE
  PAUSED
}

/// 群发 / 跟进序列：一封或多封邮件，按间隔天数依次发，客户回复或退信就停
model MailSequence {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  /// 用哪个邮箱发
  accountId   String
  ownerId     String
  status      SequenceStatus @default(ACTIVE)
  /// 每天最多发多少封（防止被邮箱服务商判为垃圾邮件）
  dailyLimit  Int            @default(100)
  /// 只在工作时间（企业时区 9–18 点）发
  workHours   Boolean        @default(true)
  stopOnReply Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     MailAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  steps       MailSequenceStep[]
  enrollments MailEnrollment[]

  @@index([tenantId, ownerId])
}

model MailSequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  sort       Int
  /// 距上一封（第一封为加入后）多少天
  delayDays  Int    @default(0)
  subject    String
  body       String

  sequence MailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, sort])
}

enum EnrollmentStatus {
  ACTIVE // 进行中
  COMPLETED // 全部发完
  REPLIED // 客户已回复
  BOUNCED // 退信
  UNSUBSCRIBED // 退订
  STOPPED // 手动停止
  FAILED // 发送失败
}

/// 序列里的一个收件人
model MailEnrollment {
  id          String           @id @default(cuid())
  tenantId    String
  sequenceId  String
  accountId   String
  email       String
  name        String?
  company     String?
  country     String?
  customerId  String?
  contactId   String?
  leadId      String?
  status      EnrollmentStatus @default(ACTIVE)
  /// 下一封是第几步（0 起）
  step        Int              @default(0)
  nextAt      DateTime?
  lastSentAt  DateTime?
  repliedAt   DateTime?
  error       String?
  createdAt   DateTime         @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence MailSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  account  MailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages MailMessage[]

  @@unique([sequenceId, email])
  @@index([status, nextAt])
  @@index([tenantId, email])
}

/// 退订 / 硬退信名单：群发时自动跳过
model MailSuppression {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  /// unsubscribe / bounce / manual
  reason    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}
