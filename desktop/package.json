{
  "name": "cheche-crm-desktop",
  "productName": "车车 CRM",
  "version": "0.2.6",
  "private": true,
  "description": "车车 CRM 桌面版：CRM 主窗口 + 内置社媒环境运行器（Camoufox）",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:runner": "node scripts/build-runner.mjs",
    "start": "npm run build:runner && electron .",
    "dev": "npm run build:runner && CRM_URL=http://localhost:3000 electron .",
    "dist": "npm run build:runner && node scripts/ensure-native.mjs && electron-builder --mac --publish never $([ -z \"$CSC_LINK\" ] && echo '-c.mac.identity=- -c.mac.hardenedRuntime=false')",
    "icons": "electron scripts/make-icons.mjs",
    "dmg-bg": "electron scripts/make-dmg-bg.mjs",
    "dist:win": "npm run build:runner && node scripts/ensure-native.mjs win && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "camoufox": "0.5.9",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.62.1",
    "resedit": "^1.7.2"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.caraicrm.desktop",
    "productName": "车车 CRM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "dist/**",
      "build/trayTemplate*.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**",
      "node_modules/**"
    ],
    "mac": {
      "artifactName": "cheche-crm-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "车车 CRM ${version}",
      "background": "build/background.tiff",
      "iconSize": 72,
      "window": {
        "width": 600,
        "height": 460
      },
      "contents": [
        {
          "x": 170,
          "y": 128,
          "type": "file"
        },
        {
          "x": 430,
          "y": 128,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 300,
          "y": 392,
          "type": "file",
          "path": "build/打不开请看我.txt"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://crm.caraicrm.com/api/desktop/update",
        "channel": "latest"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "cheche-crm-${version}-win-${arch}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "车车 CRM",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
