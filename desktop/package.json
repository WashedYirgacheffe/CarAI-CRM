{
  "name": "cheche-crm-desktop",
  "productName": "车车 CRM",
  "version": "0.2.1",
  "private": true,
  "description": "车车 CRM 桌面版：CRM 主窗口 + 内置社媒环境运行器（Camoufox）",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:runner": "node scripts/build-runner.mjs",
    "start": "npm run build:runner && electron .",
    "dev": "npm run build:runner && CRM_URL=http://localhost:3000 electron .",
    "dist": "npm run build:runner && electron-builder --mac --publish never",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "camoufox": "0.5.9",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.caraicrm.desktop",
    "productName": "车车 CRM",
    "artifactName": "cheche-crm-${version}-${arch}-mac.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "dist/**",
      "build/trayTemplate*.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**",
      "node_modules/camoufox/**",
      "node_modules/playwright-core/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "车车 CRM ${version}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://crm.caraicrm.com/api/desktop/update",
        "channel": "latest"
      }
    ]
  }
}
