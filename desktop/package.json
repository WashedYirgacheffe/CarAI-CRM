{
  "name": "cheche-crm-desktop",
  "productName": "车车 CRM",
  "version": "0.1.0",
  "private": true,
  "description": "车车 CRM 桌面版：CRM 主窗口 + 内置社媒环境运行器（Camoufox）",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:runner": "node scripts/build-runner.mjs",
    "start": "npm run build:runner && electron .",
    "dev": "npm run build:runner && CRM_URL=http://localhost:3000 electron .",
    "dist": "npm run build:runner && electron-builder --mac"
  },
  "dependencies": {
    "camoufox": "0.5.9",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.caraicrm.desktop",
    "directories": { "output": "release" },
    "productName": "车车 CRM",
    "files": ["src/**", "dist/**", "package.json"],
    "asarUnpack": ["dist/**", "node_modules/camoufox/**", "node_modules/playwright-core/**"],
    "mac": {
      "category": "public.app-category.business",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    }
  }
}
