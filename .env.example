# PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cheche_crm?schema=public"

# 加密邮箱密码的密钥（openssl rand -hex 32）。设定后不要再改，否则已绑定的邮箱需要重新输入密码
APP_SECRET=""

# AI（Anthropic Messages 兼容接口）
AI_BASE_URL="https://moonup.dev"
AI_API_KEY=""
AI_MODEL="deepseek-v4.1-flash-1017"

# 本地开发时 worker 的存储位置（默认 storage/uploads、storage/whatsapp）
# UPLOAD_DIR=""
# WA_AUTH_DIR=""

# 阿里云 OSS：产品图片视频、邮件附件、WhatsApp 媒体（不填则存本地 UPLOAD_DIR）
# RAM 子账号只需该 Bucket 的 oss:GetObject / oss:PutObject；Bucket 保持私有
OSS_BUCKET=
OSS_REGION=cn-hongkong
# 服务器与 Bucket 同地域时走内网：oss-cn-hongkong-internal.aliyuncs.com
OSS_ENDPOINT=
# 本地开发可设 dev，文件放到 dev/ 下，避免和线上混在一起
OSS_PREFIX=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
